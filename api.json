        "password": "123456"
      },
      "responses": {
        "success": {
          "status": 201,
          "body": {
            "code": 201,
            "msg": "Register successfully",
            "data": {
              "token": "<jwt_token>",
              "user": {
                "id": 1,
                "username": "user01",
                "email": "user01@example.com",
                "is_admin": false
              }
            }
          }
        },
        "error": {
          "status": 400,
