    {
      "id": 10,
      "name": "Lay danh sach san pham",
      "method": "GET",
      "path": "/api/products",
      "auth_required": false,
      "query_params": {
        "page": {
          "type": "integer",
          "default": 1
        },
        "limit": {
          "type": "integer",
          "default": 12,
          "max": 100
        },
        "search": {
          "type": "string",
          "description": "Tu khoa tim theo name hoac description"
        },
        "category": {
          "type": "string",
          "example": "racket"
        },
        "min_price": {
          "type": "number"
        },
        "max_price": {
          "type": "number"
        },
        "sort": {
          "type": "string",
          "enum": [
            "price_asc",
            "price_desc",
            "name_asc",
            "name_desc",
            "newest",
            "oldest"
          ]
        }
      },
      "example_url": "/api/products?page=1&limit=12&search=yonex&category=racket&min_price=500000&max_price=3000000&sort=price_asc",
      "responses": {
        "success": {
          "status": 200,
          "body": {
            "code": 200,
            "msg": "Get products successfully",
            "data": {
              "items": [
                {
                  "id": 1,
                  "name": "Ao Cau Long Yonex Pro",
                  "description": "Mo ta san pham",
                  "price": 450000,
                  "stock": 20,
                  "image": "https://example.com/image.png",
                  "category": "clothing",
                  "status": "active",
                  "created_at": "2026-04-29T10:00:00Z",
                  "updated_at": "2026-04-29T10:00:00Z"
                }
              ],
              "page": 1,
              "limit": 12,
              "total": 1,
              "total_pages": 1
            }
          }
        },
        "error": {
          "status": "400 or 500",
          "body": {
            "code": 400,
            "msg": "page must be a positive integer",
            "data": null
